{
  "name": "astro-blog-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-only GitHub Markdown studio for the astro-blog content repo",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:seed": "tsx scripts/seed-test-repo.ts",
    "test:clean": "tsx scripts/cleanup-test-repo.ts",
    "test:live": "vitest run tests/live",
    "test:e2e": "playwright test",
    "design:build": "node scripts/build-directions.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.0.0",
    "@fontsource/sometype-mono": "^5.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@uiw/react-codemirror": "^4.25.12",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.7",
    "idb-keyval": "^6.2.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.1",
    "marked-katex-extension": "^5.0.0",
    "motion": "^12.23.24",
    "picomatch": "^4.0.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.9.4",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "transliteration": "^2.6.1",
    "yaml": "^2.8.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.8",
    "@fingerprintjs/fingerprintjs": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/picomatch": "^3.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.16",
    "dotenv": "^17.2.3",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.0.16"
  }
}
